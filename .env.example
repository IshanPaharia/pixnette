DATABASE_URL=postgresql://neondb_owner:password@ep-host-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
COOLDOWN_SECONDS=30
CANVAS_SIZE=64
FRONTEND_URL=http://localhost:5173
WRITE_BATCH_INTERVAL_MS=2000
WRITE_FLUSH_STALE_MS=60000
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_ENABLE_CHANNEL_BINDING=true
# Optional when your database requires a custom CA:
# DATABASE_SSL_CA_FILE=/absolute/path/to/database-ca.pem

# Redis authentication
# WARNING: Do NOT use the default password in production. Override this in the VPS environment backend.env!
REDIS_PASSWORD=pixnette_secure_pass
