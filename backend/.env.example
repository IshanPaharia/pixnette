DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=3001
COOLDOWN_SECONDS=30
CANVAS_SIZE=64
FRONTEND_URL=http://localhost:5173
WRITE_BATCH_INTERVAL_MS=2000
WRITE_FLUSH_STALE_MS=60000
REDIS_URL=redis://localhost:6379
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_ENABLE_CHANNEL_BINDING=true
# Optional when your database requires a custom CA:
# DATABASE_SSL_CA_FILE=/absolute/path/to/database-ca.pem

# Redis password (override in production)
REDIS_PASSWORD=pixnette_secure_pass
